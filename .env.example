# Copy to .env (repo root or backend/) and edit. Every setting is prefixed JUDGE_CHECK_.

# Main database (docker compose maps Postgres to host port 5433).
JUDGE_CHECK_DATABASE_URL=postgresql+psycopg://judge_check:judge_check@localhost:5433/judge_check

# Database used by the test suite. It is migrated and truncated by tests: never point it at real data.
JUDGE_CHECK_TEST_DATABASE_URL=postgresql+psycopg://judge_check:judge_check@localhost:5433/judge_check_test

# Ollama (native install or `docker compose --profile ollama up -d`).
JUDGE_CHECK_OLLAMA_BASE_URL=http://localhost:11434
